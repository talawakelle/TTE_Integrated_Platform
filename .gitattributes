# Normalize text in Git repository
* text=auto

# Windows scripts checkout as CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Source/config/docs stored and checked out as LF
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf

# Binary files
*.xlsx binary
*.xls binary
*.gz binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
